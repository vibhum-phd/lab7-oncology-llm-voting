data/raw/
data/work/

# Raw model outputs can quote item text; only derived, text-free tables are committed (decided at Prompt 13).
results/raw/

# Secrets and tokens
.env
*.token
kaggle.json

# Python / OS / editor
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.venv/
Thumbs.db
desktop.ini
.DS_Store

